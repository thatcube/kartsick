{
  "name": "kartsick",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts --configLoader runner --host 127.0.0.1 --port 4173 --strictPort",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts --configLoader runner",
    "preview": "vite preview --config apps/web/vite.config.ts --configLoader runner --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
