{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kartsick",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "kartsick.brando.page", "custom_domain": true }],
  "vars": { "PUBLIC_ORIGIN": "https://kartsick.brando.page" },
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "run_worker_first": ["/rooms", "/rooms/*"],
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomObject" },
      { "name": "ADMISSION", "class_name": "Admission" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomObject", "Admission"] }],
  "observability": { "enabled": false }
}
